# Task41 A2: same G13 physics/modes with the p6 reference-preconditioned FGMRES solve.
# Official entry: python scripts/run_case.py <this file>
schema_version = 1
model_id = "task41extra_phi90_p50x50_g17x20"
run_id = "task41extra_g13_p6_phi90_iterative_a2"
comparison_group = "task41extra_phi90_p50x50_g17x20_g13_a1a2"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
geometry_identity = "task41extra_g13_rectangular_no_void"
period_x_nm = 50.0
period_y_nm = 50.0
z_min_nm = -10.0
z_max_nm = 130.0
interface_z_nm = 0.0
air_height_nm = 130.0
substrate_thickness_nm = 10.0
grating_width_x_nm = 17.0
grating_width_y_nm = 20.0
grating_height_nm = 120.0

[materials]
n_air = [1.0, 0.0]
mu_r = [1.0, 0.0]
substrate_name = "Si / silicon"
n_substrate = [0.999002304859, 0.00182649365]
grating_name = "Si / silicon"
n_grating = [0.999002304859, 0.00182649365]

[incidence]
wavelength_nm = 13.5
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
nedelec_degree = 6
visualization_degree = 6
mesh_target_nm = 10.0
mesh_cell_type = "hexahedron"
mesh_spacing_mode = "boundary_fitted"
mesh_axis_cell_counts = [10, 10, 14]
mesh_axis_x_values = [0.0, 5.5, 11.0, 16.5, 20.75, 25.0, 29.25, 33.5, 39.0, 44.5, 50.0]
mesh_axis_y_values = [0.0, 5.0, 10.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0, 45.0, 50.0]
mesh_axis_z_values = [-10.0, 0.0, 10.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 80.0, 90.0, 100.0, 110.0, 120.0, 130.0]
mesh_axis_z_profile = "task41_g13_z_minus10_0_120_130"
assembly_backend = "assembly_time_static_condensed"
floquet_constraint_mode = "auto"

[boundary]
use_floquet_x = true
use_floquet_y = true
vertical_boundary = "dtn_port"
scattering_background = "layered"
dtn_order_policy = "auto_propagating"
dtn_assembly = "auxiliary"
use_pml = false

[method]
kind = "full3d_iterative"

[solver]
linear_solver = "iterative"
ksp_type = "fgmres"
preconditioner = "task41extra_g13_p6_phi90_a2_y_orbit_reference_v1"
stage = "TASK41_A2"
initial_guess = "zero"
memory_policy = "PHYSICAL_MEMORY_PRESSURE_LOCAL_MUMPS_V23"
outer_restart = 0
physical_operator_backend = "isotropic_sum_factorized_n1e_v26"
h6_backend_rule = "direct_selected_backend_same_apply_and_power10"
thread_contract = "mpi1_omp1_blas1_v26"
restart = 32
max_iterations = 2048
task40_reference_pc_strategy = "NATIVE_AUGMENTED_RESIDUAL_QUALIFIED_V15"
task40_q_assembly_strategy = "ROW_TILE_BOUNDED_CSR_V17"
task40_factor_lifecycle_strategy = "ALL_Q_RESIDENT"

[execution]
mpi_size = 1
memory_limit_gb = 1536.0
warning_memory_gib = 1228.8
terminate_memory_gib = 1536.0
timeout_seconds = 172800
require_zero_swap = true

[output]
results_root = "results"
unique_output = true
export_fields = true
export_diffraction_orders = true
export_canonical_vectors = true
export_modal_amplitudes = true
export_reference_planes = true
reference_plane_z_nm = [10.0, 30.0, 60.0, 90.0, 110.0]
sample_count_x = 40
sample_count_y = 40
diffraction_sample_count_x = 24
diffraction_sample_count_y = 24
top_probe_z_nm = 125.0
bottom_probe_z_nm = -5.0
probe_fraction = 0.75
diffraction_order_max_m = 8
diffraction_order_max_n = 8
