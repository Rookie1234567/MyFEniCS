# Task44 sample A: six-layer, p6, assembly-time condensed direct MUMPS route.
schema_version = 1
model_id = "task44_sixlayer_0p7nm"
run_id = "sample_A_condensed_direct_20261031"
comparison_group = "task44_initial_candidates"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
period_x_nm = 2.5
period_y_nm = 2.5
z_min_nm = -0.5
z_max_nm = 3.5
interface_z_nm = 0.0
air_height_nm = 3.5
substrate_thickness_nm = 0.5
grating_width_x_nm = 0.85
grating_width_y_nm = 1.0
grating_height_nm = 3.0
grating_layer_thicknesses_nm = [0.5, 0.5, 0.5, 0.5, 0.5, 0.5]

[materials]
n_air = [1.0, 0.0]
mu_r = [1.0, 0.0]
substrate_name = "Si / silicon"
n_substrate = [0.9998851703688496, 0.0000043236152269]
grating_layer_names = [
  "Si / silicon",
  "Si0.7Ge0.3",
  "Si / silicon",
  "Si0.7Ge0.3",
  "Si / silicon",
  "SiO2 / amorphous silica",
]
grating_layer_indices = [
  [0.9998851703688496, 0.0000043236152269],
  [0.9998279652911092, 0.000039596126227885923],
  [0.9998851703688496, 0.0000043236152269],
  [0.9998279652911092, 0.000039596126227885923],
  [0.9998851703688496, 0.0000043236152269],
  [0.9998683915363351, 0.0000083314348673],
]

[incidence]
wavelength_nm = 0.7
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
nedelec_degree = 6
visualization_degree = 2
mesh_target_nm = 0.5
mesh_cell_type = "hexahedron"
mesh_spacing_mode = "boundary_fitted"
mesh_axis_cell_counts = [3, 6, 8]
assembly_backend = "assembly_time_static_condensed"
floquet_constraint_mode = "auto"

[boundary]
use_floquet_x = true
use_floquet_y = true
vertical_boundary = "dtn_port"
scattering_background = "layered"
dtn_order_policy = "auto_propagating"
dtn_assembly = "auxiliary"
use_pml = false

[method]
kind = "full3d_direct"

[solver]
direct_solver_profile = "mumps_exact"
linear_solver = "direct"
official_true_residual_tolerance = 1.0e-6
official_energy_closure_tolerance = 1.0e-5

[execution]
mpi_size = 1
warning_memory_gib = 115.2
terminate_memory_gib = 128.0
timeout_seconds = 0
require_zero_swap = true

[output]
results_root = "results"
unique_output = true
export_fields = true
export_diffraction_orders = true
diffraction_order_max_m = 7
diffraction_order_max_n = 7
export_canonical_vectors = false
export_modal_amplitudes = false
export_reference_planes = false
diffraction_sample_count_x = 15
diffraction_sample_count_y = 15
probe_fraction = 0.75
