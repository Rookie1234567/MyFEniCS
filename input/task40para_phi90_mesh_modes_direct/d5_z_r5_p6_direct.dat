# Task40 D5-Z: fixed-budget 5 nm p6 direct R5 case.
# Axes and one-axis lineage are frozen by task40_phi90_d5_z_budgeted_axes_v1; R5/q39 stay fixed.
schema_version = 1
model_id = "si_block_phi90_50x50_17x20_h120"
run_id = "task40_phi90_5_D5_Z_p6_direct_v1"
comparison_group = "task40para_phi90_mesh_modes_direct"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
period_x_nm = 50.0
period_y_nm = 50.0
z_min_nm = -10.0
z_max_nm = 130.0
interface_z_nm = 0.0
air_height_nm = 130.0
substrate_thickness_nm = 10.0
grating_width_x_nm = 17.0
grating_width_y_nm = 20.0
grating_height_nm = 120.0

[materials]
n_air = [1.0, 0.0]
mu_r = [1.0, 0.0]
substrate_name = "Si / silicon"
n_substrate = [0.99396854453, 0.00435380777]
grating_name = "Si / silicon"
n_grating = [0.99396854453, 0.00435380777]

[incidence]
wavelength_nm = 5.0
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
nedelec_degree = 6
visualization_degree = 6
mesh_target_nm = 4.0
mesh_cell_type = "hexahedron"
mesh_spacing_mode = "boundary_fitted"
assembly_backend = "standard_full"
floquet_constraint_mode = "auto"
mesh_axis_cell_counts = [10, 23, 60]
mesh_axis_x_values = [0.0, 5.5, 11.0, 16.5, 20.75, 25.0, 29.25, 33.5, 39.0, 44.5, 50.0]
mesh_axis_y_values = [0.0, 2.142857142857143, 4.285714285714286, 6.428571428571429, 8.571428571428571, 10.714285714285714, 12.857142857142858, 15.0, 17.22222222222222, 19.444444444444443, 21.666666666666668, 23.88888888888889, 26.11111111111111, 28.333333333333336, 30.555555555555557, 32.77777777777778, 35.0, 37.142857142857146, 39.285714285714285, 41.42857142857143, 43.57142857142857, 45.714285714285715, 47.85714285714286, 50.0]
mesh_axis_z_values = [-10.0, -8.75, -7.5, -6.25, -5.0, -3.75, -2.5, -1.25, 0.0, 0.5, 1.0, 2.0, 3.0, 5.0, 7.0, 11.0, 15.0, 18.214285714285715, 21.42857142857143, 24.642857142857146, 27.857142857142858, 31.07142857142857, 34.285714285714285, 37.5, 40.714285714285715, 43.92857142857143, 47.142857142857146, 50.35714285714286, 53.57142857142857, 56.785714285714285, 60.0, 63.214285714285715, 66.42857142857143, 69.64285714285714, 72.85714285714286, 76.07142857142858, 79.28571428571429, 82.5, 85.71428571428571, 88.92857142857142, 92.14285714285714, 95.35714285714286, 98.57142857142857, 101.78571428571428, 105.0, 109.0, 113.0, 115.0, 117.0, 118.0, 119.0, 119.5, 120.0, 121.25, 122.5, 123.75, 125.0, 126.25, 127.5, 128.75, 130.0]
mesh_plan_id = "task40_phi90_d5_z_budgeted_axes_v1"
mesh_plan_sha256 = "fe5d2fbe4640ceec95eab0b02dcf1fd459280f53039cedc41a82ffe7cf7b58d4"

[boundary]
use_floquet_x = true
use_floquet_y = true
vertical_boundary = "dtn_port"
scattering_background = "layered"
dtn_order_policy = "auto_propagating"
dtn_assembly = "auxiliary"
use_pml = false

[method]
kind = "full3d_direct"

[solver]
linear_solver = "direct"
direct_solver_profile = "default"
native_capacity_profile = "task40para_phi90_5_D5_Z_p6_direct_v1"

[execution]
mpi_size = 1
native_memory_policy = "interleave_nodes0_1"
time_limit_mode = "none"
warning_memory_gib = 64.0
terminate_memory_gib = 128.0
memory_limit_gb = 128.0
require_zero_swap = false

[output]
results_root = "results"
unique_output = true
export_fields = true
export_diffraction_orders = true
export_canonical_vectors = false
export_modal_amplitudes = true
export_reference_planes = true
reference_plane_z_nm = [10.0, 30.0, 60.0, 90.0, 110.0]
sample_count_x = 40
sample_count_y = 64
diffraction_sample_count_x = 24
diffraction_sample_count_y = 64
top_probe_z_nm = 110.0
bottom_probe_z_nm = 10.0
probe_fraction = 0.75
diffraction_order_max_m = 11
diffraction_order_max_n = 20
