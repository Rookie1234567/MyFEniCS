mesh_plan_sha256 = "983fe462c34a525fa23331c0001d5f8ce3648c6f386d051abcd3a6ffbaa9fc03"

[boundary]
use_floquet_x = true
use_floquet_y = true
vertical_boundary = "dtn_port"
scattering_background = "layered"
dtn_order_policy = "auto_propagating"
dtn_assembly = "auxiliary"
use_pml = false

[method]
kind = "full3d_direct"

[solver]
linear_solver = "direct"
direct_solver_profile = "default"
native_capacity_profile = "task40para_phi90_0p7_D07C_G3_M8_p6_direct_v1"

[execution]
mpi_size = 1
native_memory_policy = "interleave_nodes0_1"
time_limit_mode = "none"
warning_memory_gib = 64.0
terminate_memory_gib = 128.0
memory_limit_gb = 128.0
require_zero_swap = false

[output]
results_root = "results"
unique_output = true
export_fields = true
export_diffraction_orders = true
export_canonical_vectors = false
export_modal_amplitudes = true
export_reference_planes = true
