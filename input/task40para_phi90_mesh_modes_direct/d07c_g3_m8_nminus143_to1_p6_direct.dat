# D07C-G3_M8: RCWA-guided rough mesh screening, q81/q15 unchanged.
schema_version = 1
model_id = "si_block_phi90_50x50_17x20_h120"
run_id = "task40para_phi90_0p7_D07C_G3_M8_p6_direct_v1"
comparison_group = "task40para_phi90_mesh_modes_direct"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
period_x_nm = 50.0
period_y_nm = 50.0
z_min_nm = -10.0
z_max_nm = 130.0
interface_z_nm = 0.0
air_height_nm = 130.0
substrate_thickness_nm = 10.0
grating_width_x_nm = 17.0
grating_width_y_nm = 20.0
grating_height_nm = 120.0

[materials]
