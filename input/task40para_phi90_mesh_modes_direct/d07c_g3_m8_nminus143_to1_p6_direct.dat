n_substrate = [0.9998851259969171, 0.000004325285938225562]
grating_name = "Si / silicon"
n_grating = [0.9998851259969171, 0.000004325285938225562]

[incidence]
wavelength_nm = 0.7
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
