sample_count_y = 64
diffraction_sample_count_x = 24
diffraction_sample_count_y = 64
top_probe_z_nm = 110.0
bottom_probe_z_nm = 10.0
probe_fraction = 0.75
diffraction_order_max_m = 11
diffraction_order_max_n = 20
