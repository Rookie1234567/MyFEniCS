# Task40 D5-Y: fixed-budget 5 nm p6 direct R5 case.
# Axes and one-axis lineage are frozen by task40_phi90_d5_y_budgeted_axes_v1; R5/q39 stay fixed.
schema_version = 1
model_id = "si_block_phi90_50x50_17x20_h120"
run_id = "task40_phi90_5_D5_Y_p6_direct_v1"
comparison_group = "task40para_phi90_mesh_modes_direct"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
period_x_nm = 50.0
period_y_nm = 50.0
z_min_nm = -10.0
z_max_nm = 130.0
interface_z_nm = 0.0
air_height_nm = 130.0
substrate_thickness_nm = 10.0
grating_width_x_nm = 17.0
grating_width_y_nm = 20.0
grating_height_nm = 120.0

[materials]
n_air = [1.0, 0.0]
mu_r = [1.0, 0.0]
substrate_name = "Si / silicon"
n_substrate = [0.99396854453, 0.00435380777]
grating_name = "Si / silicon"
n_grating = [0.99396854453, 0.00435380777]

[incidence]
wavelength_nm = 5.0
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
nedelec_degree = 6
visualization_degree = 6
mesh_target_nm = 4.0
mesh_cell_type = "hexahedron"
mesh_spacing_mode = "boundary_fitted"
assembly_backend = "standard_full"
floquet_constraint_mode = "auto"
mesh_axis_cell_counts = [10, 46, 30]
