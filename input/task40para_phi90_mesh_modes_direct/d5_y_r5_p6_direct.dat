mesh_axis_y_values = [0.0, 1.0714285714285714, 2.142857142857143, 3.2142857142857144, 4.285714285714286, 5.357142857142858, 6.428571428571429, 7.5, 8.571428571428571, 9.642857142857142, 10.714285714285714, 11.785714285714285, 12.857142857142858, 13.928571428571429, 15.0, 16.11111111111111, 17.22222222222222, 18.333333333333332, 19.444444444444443, 20.555555555555557, 21.666666666666668, 22.77777777777778, 23.88888888888889, 25.0, 26.11111111111111, 27.22222222222222, 28.333333333333336, 29.444444444444446, 30.555555555555557, 31.666666666666668, 32.77777777777778, 33.888888888888886, 35.0, 36.07142857142857, 37.142857142857146, 38.214285714285715, 39.285714285714285, 40.35714285714286, 41.42857142857143, 42.5, 43.57142857142857, 44.64285714285714, 45.714285714285715, 46.78571428571429, 47.85714285714286, 48.92857142857143, 50.0]
mesh_axis_z_values = [-10.0, -7.5, -5.0, -2.5, 0.0, 1.0, 3.0, 7.0, 15.0, 21.42857142857143, 27.857142857142858, 34.285714285714285, 40.714285714285715, 47.142857142857146, 53.57142857142857, 60.0, 66.42857142857143, 72.85714285714286, 79.28571428571429, 85.71428571428571, 92.14285714285714, 98.57142857142857, 105.0, 113.0, 117.0, 119.0, 120.0, 122.5, 125.0, 127.5, 130.0]
mesh_plan_id = "task40_phi90_d5_y_budgeted_axes_v1"
