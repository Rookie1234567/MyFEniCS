# Task40 D5C-Z3: independent coarse 5 nm one-axis R5 comparison case.
# Frozen D5C one-axis plan task40_phi90_d5c_z3_axes_v1; R5/q39/q15 stay fixed.
schema_version = 1
model_id = "si_block_phi90_50x50_17x20_h120"
run_id = "task40para_phi90_5_D5C_Z3_p6_direct_v1"
comparison_group = "task40para_phi90_mesh_modes_direct"
dimension = 3

[geometry]
geometry_kind = "rectangular_block_grating"
period_x_nm = 50.0
period_y_nm = 50.0
z_min_nm = -10.0
z_max_nm = 130.0
interface_z_nm = 0.0
air_height_nm = 130.0
substrate_thickness_nm = 10.0
grating_width_x_nm = 17.0
grating_width_y_nm = 20.0
grating_height_nm = 120.0

[materials]
n_air = [1.0, 0.0]
mu_r = [1.0, 0.0]
substrate_name = "Si / silicon"
n_substrate = [0.99396854453, 0.00435380777]
grating_name = "Si / silicon"
n_grating = [0.99396854453, 0.00435380777]

[incidence]
wavelength_nm = 5.0
grazing_angle_deg = 1.0
azimuth_deg = 90.0
polarization = "s"
electric_amplitude = 1.0

[discretization]
nedelec_degree = 6
visualization_degree = 6
mesh_target_nm = 4.0
mesh_cell_type = "hexahedron"
mesh_spacing_mode = "boundary_fitted"
assembly_backend = "standard_full"
floquet_constraint_mode = "auto"
mesh_axis_cell_counts = [6, 6, 20]
mesh_axis_x_values = [0.0,8.25,16.5,25.0,33.5,41.75,50.0]
mesh_axis_y_values = [0.0,7.5,15.0,25.0,35.0,42.5,50.0]
mesh_axis_z_values = [-10.0,-8.571428571428571,-7.142857142857142,-5.714285714285714,-4.285714285714286,-2.8571428571428568,-1.4285714285714288,0.0,20.0,40.0,60.0,80.0,100.0,120.0,121.42857142857143,122.85714285714286,124.28571428571429,125.71428571428571,127.14285714285714,128.57142857142858,130.0]
mesh_plan_id = "task40_phi90_d5c_z3_axes_v1"
mesh_plan_sha256 = "f848db268463270e2829f349dbf469535db38f23952c7380df4c9faadd706f0d"

[boundary]
use_floquet_x = true
use_floquet_y = true
vertical_boundary = "dtn_port"
scattering_background = "layered"
dtn_order_policy = "auto_propagating"
dtn_assembly = "auxiliary"
use_pml = false

[method]
kind = "full3d_direct"

[solver]
linear_solver = "direct"
direct_solver_profile = "default"
native_capacity_profile = "task40para_phi90_5_D5C_Z3_p6_direct_v1"

[execution]
mpi_size = 1
native_memory_policy = "interleave_nodes0_1"
time_limit_mode = "none"
warning_memory_gib = 64.0
terminate_memory_gib = 128.0
memory_limit_gb = 128.0
require_zero_swap = false

[output]
results_root = "results"
unique_output = true
export_fields = true
export_diffraction_orders = true
export_canonical_vectors = false
export_modal_amplitudes = true
export_reference_planes = true
reference_plane_z_nm = [10.0, 30.0, 60.0, 90.0, 110.0]
sample_count_x = 40
sample_count_y = 64
diffraction_sample_count_x = 24
diffraction_sample_count_y = 64
top_probe_z_nm = 110.0
bottom_probe_z_nm = 10.0
probe_fraction = 0.75
diffraction_order_max_m = 11
diffraction_order_max_n = 20
