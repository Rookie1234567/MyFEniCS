  "script_sha256": "2fa46ce97d7d79b45041ed0d56fc8d28b27ab5a135f2397ea17f5b756177d3a1",
  "script_source": "\"\"\"Read-only V25 audit: cached arrays and records, no PDE/operator/LU/QR/SVD.\"\"\"\nfrom pathlib import Path\nfrom copy import deepcopy\nimport csv, hashlib, json, subprocess\nimport numpy as np\nfrom benchmarks.collect_task042_block_direction import check_arrays\nfrom benchmarks.check_task042_local_block_records import check\n\nROOT=Path.cwd(); D=ROOT/'docs/task042_neural_coarse_inverse'; R=D/'outcomes/records'\nHEAD='f1c970ec0d96992ee2a9d098f7d3d2a8b4a5a786'\nBASE='8e23b9f4620510c5f578c334faa63a06b4c410a3'\nread=lambda p:json.loads(Path(p).read_text())\nsha=lambda b:hashlib.sha256(b).hexdigest()\nah=lambda a:sha(np.ascontiguousarray(a).tobytes())\nassert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==HEAD\nverified={}\ndef verify(item):\n    p=Path(item['path']); data=p.read_bytes()\n    assert sha(data)==item['sha256'],p\n    verified[str(p)]=dict(path=str(p),sha256=item['sha256'],bytes=len(data))\n    return data\nindex=read(R/'run_index_v25.json'); result=json.loads(verify(index['result']))\nfor item in index['files'].values():verify(item)\nsource=read(R/'source_inventory_v25.json')\nfor item in source['source_files']:verify(item)\nfor key in ('collector','metadata_closer','window','journal','minimum_result','historical_review_evidence'):verify(source[key])\nassert result['source_sha']==index['actual_source_sha']==source['actual_run_source_sha']=='bc88fe5a81d086059dec705db333b9cf9bf2921e'\nsummary=read(index['files']['run_summary.json']['path'])\nassert summary['classification']=='COMPLETED' and summary['descendants_cleared'] and not summary['remaining_child_pids']\nmanifest=read(index['files']['run_manifest.json']['path'])\nassert not manifest['formal_pde'] and manifest['offline_diagnostic'] and not manifest['new_solver_result']\nplan=read(ROOT/'input/task042_neural_coarse_inverse/block_residual_direction_v25.json')\nsetup=json.loads(verify(plan['local_setup'])); verify(plan['map'])\ngroups=[np.asarray(b['rows']) for b in setup['block_inventory']]\nnames=['V24-LZ-INITIAL','V24-LZ-CYCLE4','V24-LCZ-CYCLE4']\nassert [row['name'] for row in result['rows']]==names\nfor item in plan['states']:\n    verify(item['parent_result']);verify(item['state'])\n    with np.load(item['state']['path'],allow_pickle=False) as f:\n        a={key:f[key] for key in ('trace','port','z','residual')}\n    for key,value in a.items():assert ah(value)==item['state'][key+'_sha256']\n    assert np.array_equal(a['z'][:18144],a['trace']) and np.array_equal(a['z'][18144:],a['port'])\nfor item in index['row_artifacts']:\n    verify(item['metadata']);verify(item['arrays'])\ncached=check_arrays(result)\ncost=read(R/'resource_costs_v25.json')\nfor item in cost['auxiliary_runs']:\n    verify(item['file']);verify(item['log'])\n    a=read(item['file']['path'])\n    assert a['elapsed_seconds']==item['elapsed_seconds'] and a['sampled_process_tree_rss_peak_bytes']==item['RSS_peak_bytes']\n    assert a['descendants_cleared'] and not a['sampled_process_tree_swap_peak_bytes']\nassert abs(sum(x['elapsed_seconds'] for x in cost['auxiliary_runs'])-cost['auxiliary_supervised_wall_seconds'])<1e-10\nassert summary['elapsed_seconds']==cost['actor_supervised_wall_seconds']\nassert max([summary['sampled_process_tree_rss_peak_bytes']]+[i['RSS_peak_bytes'] for i in cost['auxiliary_runs']])==cost['simultaneous_sampled_tree_peak_bytes']\nassert result['budget_counts']==cost['mathematical_counts']==cost['ledger']['charged']\nassert cost['ledger']['closed'] and cost['ledger']['active'] is None and len(cost['ledger']['runs'])==1\nassert summary['clock_end']['utc_ns']/1e9 < 1790986575 # 2026-10-03T00:16:15Z\nmetrics=[]\nfor row in result['rows']:\n    with np.load(row['input_state']['path'],allow_pickle=False) as f:r=f['residual'][:18144]\n    with np.load(row['diagnostic_arrays']['path'],allow_pickle=False) as f:\n        V=f['images'];c=f['coefficients'];q=f['directions']\n    nr=np.linalg.norm(r); W=V/np.linalg.norm(V,axis=0); G=W.conj().T@W\n    radii=np.sum(np.abs(G),axis=1)-np.abs(np.diag(G))\n    lower=float(np.min(np.real(np.diag(G))-radii)); upper=float(np.max(np.real(np.diag(G))+radii))\n    assert lower>0 # independent full-rank certificate, not a normal-equation solve\n    cross=next(x for x in row['block_response'] if x['target_block']==7)\n    coupling=cross['response_norms'][5]/row['response_column_norms'][5]\n    offdiag=sorted([(x['response_norms'][j]/row['response_column_norms'][j],j,x['target_block']) for x in row['block_response'] for j in range(8) if j!=x['target_block']],reverse=True)\n    pair_fraction=float((np.linalg.norm(r[groups[5]])**2+np.linalg.norm(r[groups[7]])**2)/nr**2)\n    station=float(np.linalg.norm(W.conj().T@(r-V@c))/(np.linalg.norm(W)*(nr+np.linalg.norm(V@c))))\n    ratio=float(np.linalg.norm(r-V@c)/nr)\n    assert abs(ratio-row['eta8'])<1e-11\n    assert station<1e-8\n    metrics.append(dict(name=row['name'],eta8=ratio,norm_decrease=1-ratio,squared_fraction_removed=1-ratio**2,\n        residual_norm=float(nr),stationarity=station,gram_gershgorin_lower=lower,gram_gershgorin_upper=upper,\n        derived_singular_ratio_lower=float(np.sqrt(lower/upper)),no_new_QR_SVD=True,\n        source5_target7_ratio=coupling,source5_target7_rank=[(j,i) for _,j,i in offdiag].index((5,7))+1,\n        largest_offdiagonal_response_ratio=dict(source=offdiag[0][1],target=offdiag[0][2],ratio=offdiag[0][0]),\n        residual_squared_fraction_in_blocks5and7=pair_fraction))\n\n# Mutations of in-memory metadata only, to test the evidence-checker's contract.\nprobes=[]\nfor label,rows in [('empty',[]),('one_final',[result['rows'][1]]),('duplicate_final',[result['rows'][1],result['rows'][1]])]:\n    mutation=deepcopy(result);mutation['rows']=rows\n    checked=check_arrays(mutation)\n    probes.append(dict(mutation=label,rows=len(rows),observed_status=checked['status'],observed_decision=checked['decision'],expected='reject incomplete/duplicate frozen inventory'))\n    assert checked['status']=='CHECKED'\n\nchanges=subprocess.check_output(['git','diff','--name-only',BASE,HEAD],text=True).splitlines()\nassert len(changes)==37\nold_inventory=read(R/'independent_review_v21_20261002.json')['task_inventory']['files']\nallowed={str(D.relative_to(ROOT)/p) for p in ('README.md','review_report_v21.md','outcomes/summary.md','outcomes/test_summary.md','outcomes/changed_files.md')}\nold_different=[x['path'] for x in old_inventory if sha(Path(x['path']).read_bytes())!=x['sha256']]\nassert set(old_different)==allowed\nfor pattern in ('review_report_v*.md','response_v*.md'):\n    for p in D.glob(pattern):\n        if p.name=='response_v25.md':continue\n        rel=str(p.relative_to(ROOT)); assert subprocess.check_output(['git','show',BASE+':'+rel])==p.read_bytes()\nrows=sum(1 for _ in csv.DictReader((R/'complex_cross_terms_v25.csv').open()))\nassert rows==864\nout=dict(schema_version=1,reviewed_HEAD=HEAD,review_base=BASE,review_date_utc8='2026-10-03',\n    actual_run_source=result['source_sha'],changed_files=[dict(path=p,bytes=Path(p).stat().st_size,sha256=sha(Path(p).read_bytes())) for p in changes],\n    prior_full_inventory_files=len(old_inventory),historical_changes_since_first_index=old_different,\n    prior_reviews_responses_unchanged=True,verified_files=list(verified.values()),verified_bytes=sum(x['bytes'] for x in verified.values()),\n    original_checker=check(R),cached_checker=cached,independent_cached_analysis=metrics,\n    collector_inventory_probes=probes,probe_scope='in-memory metadata only; no records changed; cached arrays read; no fine action or decomposition',\n    focused_tests=dict(passed=78,seconds=3.33,command='python -m pytest -q src/test/test_task042_v24_compact_qualification.py src/test/test_task042_v25_block_direction.py src/test/test_task042_v24_admission.py',mode='qualified pure numpy1.26.4 scipy1.11.4 math1'),\n    cost=dict(actor_wall=cost['actor_supervised_wall_seconds'],launch_wall=cost['actor_launch_wall_seconds'],auxiliary_wall=cost['auxiliary_supervised_wall_seconds'],tree_peak=cost['simultaneous_sampled_tree_peak_bytes'],counts=cost['mathematical_counts']),\n    candidate_joint_block=dict(zero_based_blocks=[5,7],rows=len(groups[5])+len(groups[7]),matrix_and_LU_bytes=32*(len(groups[5])+len(groups[7]))**2,not_run=True),\n    scope_limits=['no new original operator applications','no LU/QR/SVD in raw audit','no FE integration, new PDE or training','large LU and action packet payloads not all rehashed','not every repository file audited line by line','GitHub precise rendered page Cache miss; NOT_VERIFIED'],\n    script_sha256=sha(Path(__file__).read_bytes()))\nPath('/tmp/task042_review23_evidence.json').write_text(json.dumps(out,ensure_ascii=False,indent=2,allow_nan=False)+'\\n')\nprint(json.dumps({k:out[k] for k in ('verified_bytes','original_checker','independent_cached_analysis','collector_inventory_probes','cost','candidate_joint_block')},ensure_ascii=False,indent=2))\n",
