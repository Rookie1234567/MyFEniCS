  "reproducer": "\"\"\"Review V27 metadata and saved baselines; no real S/SH, factors, QR/SVD or FE.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,subprocess\nimport numpy as np\nfrom benchmarks.collect_task042_joint_direction import verify_cached\nfrom src.runners.task042_shared import spare_cores\nROOT=Path.cwd();D=ROOT/'docs/task042_neural_coarse_inverse';R=D/'outcomes/records'\nHEAD='1e7703ccb4202f7ba1b358c0493a80e3031f8e8c';BASE='222aa0af9385d9cd38dd25b11f416ecd8b702957'\nread=lambda p:json.loads(Path(p).read_text());sha=lambda b:hashlib.sha256(b).hexdigest()\nassert subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()==HEAD\nverified={}\ndef verify(item):\n p=Path(item.get('path',item.get('file')));b=p.read_bytes();assert sha(b)==item['sha256'],str(p)\n verified[str(p.resolve())]=dict(path=str(p.resolve()),sha256=sha(b),bytes=len(b));return p\ndef walk(v):\n if isinstance(v,dict):\n  if ('path' in v or 'file' in v) and 'sha256' in v:verify(v)\n  else:\n   for child in v.values():walk(child)\n elif isinstance(v,list):\n  for child in v:walk(child)\nindex=read(R/'run_index_v27.json');walk(index)\nsource=read(R/'source_inventory_v27.json');walk(source)\nfor item in source['files']:\n assert sha(subprocess.check_output(['git','show',source['candidate_entry_source_sha']+':'+item['file']]))==item['sha256']\nassert source['numeric_actor_source_sha'] is None\nbook=read(index['ledger']['path']);assert book['runs']==[] and book['active'] is None and book['closed'] and not any(book['charged'].values())\nassert not list((ROOT/'results/task042').glob('task042_v27_*'))\nart=ROOT/'benchmarks/artifacts/task042/v27';artfiles=sorted(str(p.relative_to(ROOT)) for p in art.rglob('*') if p.is_file())\nassert not any(Path(p).suffix in ('.npz','.npy') for p in artfiles)\nplan=read(ROOT/'input/task042_neural_coarse_inverse/return_block_direction_v27.json')\nfor k in ('local_setup','v25_result','v26_result','map'):verify(plan[k])\nprior=read(plan['v26_result']['path']);names=['V24-LZ-CYCLE4','V24-LCZ-CYCLE4']\nassert [x['name'] for x in plan['states']]==names\nfor row in plan['states']:\n for k in ('parent_result','state','v25_arrays','v26_arrays'):verify(row[k])\nold_checker=verify_cached(prior)\ninputs=read(R/'input_inventory_v27.json');walk(inputs)\nresults=read(R/'return_direction_results_v27.json');walk(results)\nparent_findings=[]\nfor row,item,actual in zip(inputs['states'],plan['states'],results['rows'],strict=True):\n assert row['name']==actual['name']==item['name'] and row['input_state']==actual['input_state']==item['state']\n assert all(actual[k] is None for k in ('eta10','g10','new_direction_resolved'))\n assert row['parent'] is None and actual['parent'] is None and item['parent_result']['sha256']\n parent_findings.append(dict(name=row['name'],published_parent=row['parent'],authoritative_parent_result=item['parent_result'],state_and_baseline_hashes_match=True))\ncost=read(R/'resource_costs_v27.json');walk(cost)\nassert cost['formal_actor_runs']==0 and cost['formal_actor_wall_seconds']==0 and cost['numeric_factor_readers']==0\nassert abs(sum(x['elapsed_seconds'] for x in cost['auxiliary_runs'])-cost['supervised_auxiliary_wall_seconds'])<1e-10\naux=[]\nfor item in cost['auxiliary_runs']:\n s=read(item['summary']['path']);b=read(item['baseline']['path']);timeline=[json.loads(x) for x in Path(item['resources']['path']).read_text().splitlines()]\n assert s['classification']=='COMPLETED' and s['descendants_cleared'] and not s['remaining_child_pids']\n assert max(x['rss_bytes'] for x in timeline)==s['sampled_process_tree_rss_peak_bytes']==item['RSS_peak_bytes']\n assert max(x['swap_bytes'] for x in timeline)==0\n assert s['elapsed_seconds']==item['elapsed_seconds']\n candidates=spare_cores(b['topology'],b['neighbor_processes'],{int(k):v for k,v in b['cpu_busy_fractions'].items()},{int(k):v for k,v in b['thread_delta_ticks'].items()})\n assert candidates==b['candidate_cpus'] and candidates[0]==item['cpu']\n aux.append(