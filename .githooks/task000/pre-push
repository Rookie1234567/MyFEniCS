#!/usr/bin/env bash
set -euo pipefail

readonly TASK000_GUARD_ID="myfenics-surrogate-task000-v1"
readonly EXPECTED_BRANCH="codex/only-one-13p5nm-surrogate-inversion"
readonly EXPECTED_REF="refs/heads/${EXPECTED_BRANCH}"
readonly EXPECTED_ORIGIN="https://github.com/Rookie1234567/MyFEniCS.git"
readonly ZERO_SHA="0000000000000000000000000000000000000000"

remote_name="${1:-}"
remote_url="${2:-}"
[[ "${remote_name}" == "origin" ]] || {
  echo "BLOCKED: pushes are allowed only to origin" >&2
  exit 1
}
[[ "${remote_url}" == "${EXPECTED_ORIGIN}" ]] || {
  echo "BLOCKED: push URL is not the qualified Task000 remote" >&2
  exit 1
}
[[ "$(git branch --show-current)" == "${EXPECTED_BRANCH}" ]] || {
  echo "BLOCKED: push attempted outside ${EXPECTED_BRANCH}" >&2
  exit 1
}

seen=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_ref:-}" ]] || continue
  seen=1
  [[ "${local_ref}" == "${EXPECTED_REF}" || "${local_ref}" == "HEAD" ]] || {
    echo "BLOCKED: local ref ${local_ref} is not HEAD/${EXPECTED_REF}" >&2
    exit 1
  }
  [[ "${remote_ref}" == "${EXPECTED_REF}" ]] || {
    echo "BLOCKED: remote ref ${remote_ref} is not ${EXPECTED_REF}" >&2
    exit 1
  }
  [[ "${local_sha}" != "${ZERO_SHA}" ]] || {
    echo "BLOCKED: branch deletion is forbidden" >&2
    exit 1
  }
  [[ "${local_sha}" == "$(git rev-parse HEAD)" ]] || {
    echo "BLOCKED: local SHA is not the checked-out branch HEAD" >&2
    exit 1
  }
  if [[ "${remote_sha}" != "${ZERO_SHA}" ]]; then
    git merge-base --is-ancestor "${remote_sha}" "${local_sha}" || {
      echo "BLOCKED: non-fast-forward/force push is forbidden" >&2
      exit 1
    }
  fi
done

[[ "${seen}" -eq 1 ]] || {
  echo "BLOCKED: no explicit branch update was supplied" >&2
  exit 1
}
