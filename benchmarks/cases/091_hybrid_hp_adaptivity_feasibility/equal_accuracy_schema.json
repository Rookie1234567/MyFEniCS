{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task033.case091.equal-accuracy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "case_id",
    "status",
    "identity",
    "tolerances",
    "inputs",
    "reference",
    "candidates",
    "selection",
    "classification_boundaries",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "task033.case091.equal-accuracy.v1"},
    "record_type": {"const": "task033_global_equal_accuracy_efficiency"},
    "case_id": {"const": "091_hybrid_hp_adaptivity_feasibility"},
    "status": {"enum": ["qualified", "not_qualified"]},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_pde_run",
        "consumes_measured_pde_records",
        "ordinary_default_changed",
        "proves_0p7nm_feasible",
        "source_commit_full_sha",
        "all_qualified_inputs_same_clean_sha"
      ],
      "properties": {
        "is_pde_run": {"const": false},
        "consumes_measured_pde_records": {"const": true},
        "ordinary_default_changed": {"const": false},
        "proves_0p7nm_feasible": {"const": false},
        "source_commit_full_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "all_qualified_inputs_same_clean_sha": {"type": "boolean"}
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rta_absolute_max",
        "significant_order_power",
        "significant_order_complex_amplitude_relative_max",
        "interface_e_relative_max",
        "interface_h_relative_max",
        "selected_plane_field_relative_max",
        "qep_beta_relative_max_when_available",
        "true_residual_max"
      ],
      "properties": {
        "rta_absolute_max": {"const": 0.00001},
        "significant_order_power": {"const": 1e-8},
        "significant_order_complex_amplitude_relative_max": {"const": 0.001},
        "interface_e_relative_max": {"const": 0.005},
        "interface_h_relative_max": {"const": 0.01},
        "selected_plane_field_relative_max": {"const": 0.005},
        "qep_beta_relative_max_when_available": {"const": 0.001},
        "true_residual_max": {"const": 1e-9}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidates"],
      "properties": {
        "reference": {"$ref": "#/$defs/input"},
        "candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "case",
        "selected_mode_count_per_direction",
        "source_commit_full_sha",
        "costs"
      ],
      "properties": {
        "label": {"type": "string"},
        "case": {"type": "object"},
        "selected_mode_count_per_direction": {"type": "integer", "minimum": 1},
        "source_commit_full_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "costs": {"$ref": "#/$defs/costs"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_candidate_count",
        "pareto_frontier_candidate_ids",
        "best_candidate_id",
        "best_candidate_label",
        "criterion"
      ],
      "properties": {
        "qualified_candidate_count": {"type": "integer", "minimum": 0},
        "pareto_frontier_candidate_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "best_candidate_id": {"type": ["string", "null"]},
        "best_candidate_label": {"type": ["string", "null"]},
        "criterion": {"type": "string"}
      }
    },
    "classification_boundaries": {
      "const": {
        "weak": "<1.3",
        "positive": ">=1.3 and <2",
        "clear": ">=2 and <3",
        "engineering": ">=3 and <5",
        "strong": ">=5"
      }
    },
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "funnel_path",
        "funnel_sha256",
        "selected_mode_count_per_direction",
        "selected_watchdog_path",
        "selected_watchdog_sha256",
        "source_commit_full_sha"
      ],
      "properties": {
        "funnel_path": {"type": "string"},
        "funnel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_mode_count_per_direction": {"type": "integer", "minimum": 1},
        "selected_watchdog_path": {"type": "string"},
        "selected_watchdog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit_full_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_dofs",
        "total_rows",
        "assembled_nnz",
        "authoritative_rss_bytes",
        "authoritative_rss_gib",
        "total_time_seconds"
      ],
      "properties": {
        "local_dofs": {"type": "integer", "minimum": 1},
        "total_rows": {"type": "integer", "minimum": 1},
        "assembled_nnz": {"type": "integer", "minimum": 1},
        "authoritative_rss_bytes": {"type": "integer", "minimum": 1},
        "authoritative_rss_gib": {"type": "number", "exclusiveMinimum": 0},
        "total_time_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "label",
        "status",
        "case",
        "selected_mode_count_per_direction",
        "source_commit_full_sha",
        "input",
        "costs",
        "compression_ratios",
        "local_dof_compression_classification",
        "gates",
        "comparisons",
        "failures"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate_[1-9][0-9]*$"},
        "label": {"type": "string"},
        "status": {"enum": ["equal_accuracy_qualified", "not_qualified"]},
        "case": {"type": ["object", "null"]},
        "selected_mode_count_per_direction": {"type": ["integer", "null"]},
        "source_commit_full_sha": {
          "anyOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "input": {"type": "object"},
        "costs": {"anyOf": [{"$ref": "#/$defs/costs"}, {"type": "null"}]},
        "compression_ratios": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "local_dofs",
                "total_rows",
                "assembled_nnz",
                "authoritative_rss_bytes",
                "total_time_seconds"
              ],
              "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
            },
            {"type": "null"}
          ]
        },
        "local_dof_compression_classification": {
          "type": ["string", "null"],
          "enum": ["weak", "positive", "clear", "engineering", "strong", null]
        },
        "gates": {"type": "object"},
        "comparisons": {"type": "object"},
        "failures": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "qualified"}}},
      "then": {
        "properties": {
          "selection": {
            "properties": {
              "qualified_candidate_count": {"minimum": 1},
              "best_candidate_id": {"type": "string"},
              "best_candidate_label": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
