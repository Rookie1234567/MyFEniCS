{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task033.case091.qep-records.v1",
  "title": "Task033 Case091 QEP plan and guarded measurement shard",
  "oneOf": [
    {"$ref": "#/$defs/planRecord"},
    {"$ref": "#/$defs/shardRecord"}
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_kind", "degree", "h_nm", "mpi_size"],
      "properties": {
        "material_kind": {
          "enum": ["air", "lossy_homogeneous", "stage4_xy"]
        },
        "degree": {"enum": [1, 2, 3, 4]},
        "h_nm": {"enum": [5.0, 3.0, 2.5, 2.0, 1.5]},
        "mpi_size": {"enum": [1, 2, 4]}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_pde_run",
        "is_solver_pass",
        "is_memory_measurement",
        "ordinary_default_changed",
        "proves_0p7nm_feasible"
      ],
      "properties": {
        "is_pde_run": {"type": "boolean"},
        "is_solver_pass": {"type": "boolean"},
        "is_memory_measurement": {"type": "boolean"},
        "result_identity": {"type": "string"},
        "ordinary_default_changed": {"const": false},
        "proves_0p7nm_feasible": {"const": false},
        "scope": {"type": "string"}
      }
    },
    "memoryPrediction": {
      "type": "object",
      "required": [
        "data_identity",
        "scope",
        "full_dof_upper_bound",
        "reduced_dof_upper_bound",
        "four_matrix_nnz_upper_bound",
        "centers_gib",
        "conservative_upper_gib",
        "prediction_gate_pass",
        "gate_limits"
      ],
      "properties": {
        "data_identity": {"const": "predicted_not_measured"},
        "scope": {"const": "cross_section_qep_component_only"},
        "full_dof_upper_bound": {"type": "integer", "minimum": 1},
        "reduced_dof_upper_bound": {"type": "integer", "minimum": 1},
        "four_matrix_nnz_upper_bound": {"type": "integer", "minimum": 1},
        "centers_gib": {
          "type": "object",
          "required": [
            "four_sparse_coefficients_and_pep_vectors",
            "direct_factor_workspace"
          ],
          "properties": {
            "four_sparse_coefficients_and_pep_vectors": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "direct_factor_workspace": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "conservative_upper_gib": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "prediction_gate_pass": {"type": "boolean"},
        "gate_limits": {"type": "object"}
      }
    },
    "runtimePreflight": {
      "type": "object",
      "required": [
        "runtime_contract_verified",
        "launch_eligible",
        "failures",
        "default_behavior",
        "one_shard_per_process_contract"
      ],
      "properties": {
        "runtime_contract_verified": {"type": "boolean"},
        "launch_eligible": {"type": "boolean"},
        "failures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "default_behavior": {"const": "unknown_fail_closed"},
        "one_shard_per_process_contract": {"const": true}
      }
    },
    "planEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrix_key",
        "candidate",
        "analytic_beta_available",
        "memory_prediction",
        "runtime_preflight",
        "launch_eligible",
        "execution_status",
        "result_identity",
        "is_pde_run",
        "is_solver_pass",
        "numerical_results"
      ],
      "properties": {
        "matrix_key": {"type": "string", "minLength": 1},
        "candidate": {"$ref": "#/$defs/candidate"},
        "analytic_beta_available": {"type": "boolean"},
        "memory_prediction": {"$ref": "#/$defs/memoryPrediction"},
        "runtime_preflight": {"$ref": "#/$defs/runtimePreflight"},
        "launch_eligible": {"const": false},
        "execution_status": {
          "enum": ["not_run_by_memory_gate", "not_run_runtime_contract"]
        },
        "result_identity": {"const": "not_run"},
        "is_pde_run": {"const": false},
        "is_solver_pass": {"const": false},
        "numerical_results": {"type": "null"}
      }
    },
    "planRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "case_id",
        "status",
        "identity",
        "axes",
        "requested_modes",
        "runtime_contract",
        "summary",
        "artifact_provenance",
        "entries",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "task033.case091.qep-plan.v1"},
        "record_type": {"const": "task033_qep_measurement_plan"},
        "case_id": {"const": "091_hybrid_hp_adaptivity_feasibility"},
        "status": {"const": "not_run"},
        "identity": {
          "allOf": [
            {"$ref": "#/$defs/identity"},
            {
              "properties": {
                "is_pde_run": {"const": false},
                "is_solver_pass": {"const": false},
                "is_memory_measurement": {"const": false}
              }
            }
          ]
        },
        "axes": {
          "const": {
            "material_kinds": ["air", "lossy_homogeneous", "stage4_xy"],
            "degrees": [1, 2, 3, 4],
            "h_nm": [5.0, 3.0, 2.5, 2.0, 1.5],
            "mpi_sizes": [1, 2, 4],
            "entry_count": 180
          }
        },
        "requested_modes": {"type": "integer", "minimum": 2},
        "runtime_contract": {"type": "object"},
        "summary": {
          "type": "object",
          "required": [
            "entries",
            "execution_status_counts",
            "measured_entries",
            "solver_pass_entries"
          ],
          "properties": {
            "entries": {"const": 180},
            "execution_status_counts": {"type": "object"},
            "measured_entries": {"const": 0},
            "solver_pass_entries": {"const": 0}
          }
        },
        "artifact_provenance": {"type": "object"},
        "entries": {
          "type": "array",
          "minItems": 180,
          "maxItems": 180,
          "items": {"$ref": "#/$defs/planEntry"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "numericalResults": {
      "type": "object",
      "required": [
        "full_dof",
        "reduced_dof",
        "four_matrix_nnz",
        "four_matrix_nnz_total",
        "selected_beta_per_nm",
        "analytic_beta_per_nm",
        "analytic_beta_relative_error",
        "polynomial_relative_residual",
        "assembly_seconds_max_rank",
        "solve_seconds_max_rank",
        "classification_seconds_max_rank",
        "retained_eigenvector_bytes",
        "left_right_classification",
        "quadrature"
      ],
      "properties": {
        "full_dof": {"type": "integer", "minimum": 1},
        "reduced_dof": {"type": "integer", "minimum": 1},
        "four_matrix_nnz": {
          "type": "object",
          "required": ["K0", "K1", "K2", "electric_mass"],
          "properties": {
            "K0": {"type": "integer", "minimum": 0},
            "K1": {"type": "integer", "minimum": 0},
            "K2": {"type": "integer", "minimum": 0},
            "electric_mass": {"type": "integer", "minimum": 0}
          }
        },
        "four_matrix_nnz_total": {"type": "integer", "minimum": 0},
        "selected_beta_per_nm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "analytic_beta_per_nm": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          ]
        },
        "analytic_beta_relative_error": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "polynomial_relative_residual": {"type": "number", "minimum": 0},
        "assembly_seconds_max_rank": {"type": "number", "minimum": 0},
        "solve_seconds_max_rank": {"type": "number", "minimum": 0},
        "classification_seconds_max_rank": {"type": "number", "minimum": 0},
        "retained_eigenvector_bytes": {
          "type": "object",
          "required": [
            "right_reduced",
            "right_full",
            "left_reduced",
            "left_full",
            "total",
            "scalar_bytes",
            "full_vector_gathered_to_root"
          ],
          "properties": {
            "right_reduced": {"type": "integer", "minimum": 0},
            "right_full": {"type": "integer", "minimum": 0},
            "left_reduced": {"type": "integer", "minimum": 0},
            "left_full": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "scalar_bytes": {"const": 16},
            "full_vector_gathered_to_root": {"const": false}
          }
        },
        "left_right_classification": {
          "type": "object",
          "required": [
            "right_polynomial_relative_residual_max",
            "left_polynomial_relative_residual_max",
            "biorthogonality_identity_error",
            "left_pair_relative_errors",
            "directions",
            "kinds",
            "passive_branch_valid",
            "full_vector_gathered"
          ],
          "properties": {
            "right_polynomial_relative_residual_max": {"type": "number", "minimum": 0},
            "left_polynomial_relative_residual_max": {"type": "number", "minimum": 0},
            "biorthogonality_identity_error": {"type": "number", "minimum": 0},
            "left_pair_relative_errors": {
              "type": "array",
              "items": {"type": "number", "minimum": 0}
            },
            "directions": {"type": "array", "items": {"type": "string"}},
            "kinds": {"type": "array", "items": {"type": "string"}},
            "passive_branch_valid": {
              "type": "array",
              "items": {"type": "boolean"}
            },
            "full_vector_gathered": {"const": false}
          }
        },
        "quadrature": {
          "type": "object",
          "required": [
            "field_degree",
            "geometry_degree",
            "coefficient_degree",
            "selected_degree",
            "policy"
          ]
        }
      }
    },
    "shardRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "case_id",
        "status",
        "identity",
        "candidate",
        "memory_prediction",
        "runtime_preflight",
        "provenance",
        "numerical_results",
        "resource_measurements",
        "gates"
      ],
      "properties": {
        "schema_version": {"const": "task033.case091.qep-measurement.v1"},
        "record_type": {"const": "task033_qep_measurement_shard"},
        "case_id": {"const": "091_hybrid_hp_adaptivity_feasibility"},
        "status": {
          "enum": [
            "not_run_by_memory_gate",
            "not_run_runtime_contract",
            "terminated_by_memory_gate",
            "measured_gates_passed",
            "measured_gates_failed",
            "execution_failed"
          ]
        },
        "identity": {"$ref": "#/$defs/identity"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "memory_prediction": {"$ref": "#/$defs/memoryPrediction"},
        "runtime_preflight": {"$ref": "#/$defs/runtimePreflight"},
        "provenance": {"type": "object"},
        "numerical_results": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/numericalResults"}
          ]
        },
        "resource_measurements": {
          "oneOf": [{"type": "null"}, {"type": "object"}]
        },
        "gates": {
          "type": "object",
          "required": ["all_required_numerical_gates_pass"],
          "properties": {
            "all_required_numerical_gates_pass": {"type": "boolean"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["not_run_by_memory_gate", "not_run_runtime_contract"]
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "is_pde_run": {"const": false},
                  "is_solver_pass": {"const": false},
                  "is_memory_measurement": {"const": false},
                  "result_identity": {"const": "not_run"}
                }
              },
              "numerical_results": {"type": "null"},
              "resource_measurements": {"type": "null"},
              "gates": {
                "properties": {
                  "all_required_numerical_gates_pass": {"const": false}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "measured_gates_passed"}}
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {
                  "is_pde_run": {"const": true},
                  "is_solver_pass": {"const": true},
                  "is_memory_measurement": {"const": true},
                  "result_identity": {"const": "measured"}
                }
              },
              "numerical_results": {"$ref": "#/$defs/numericalResults"},
              "resource_measurements": {"type": "object"},
              "gates": {
                "properties": {
                  "all_required_numerical_gates_pass": {"const": true}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "terminated_by_memory_gate",
                  "measured_gates_failed",
                  "execution_failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "identity": {
                "properties": {"is_solver_pass": {"const": false}}
              },
              "gates": {
                "properties": {
                  "all_required_numerical_gates_pass": {"const": false}
                }
              }
            }
          }
        }
      ]
    }
  }
}
